# Application Config
ENVIRONMENT=production
DEBUG=false

# Database - Apache Cassandra
CASSANDRA_CONTACT_POINTS=cassandra-node1,cassandra-node2
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=graphgpt_conversations
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_LOCAL_DC=us-east-1
CASSANDRA_TIMEOUT_SECONDS=5.0

# Cache - Redis URL (Single node or Cluster Node endpoint matching auth-service)
REDIS_URL=redis://redis-master:6379/0
REDIS_NODES=redis-node1:7000,redis-node2:7001
REDIS_TIMEOUT_SECONDS=2.0

# Event Bus - Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=kafka-broker1:9092,kafka-broker2:9092

# gRPC Services
LLM_SERVICE_GRPC_ENDPOINT=llm-service:50051

# JWT Zero-Trust Validation (Must match authentication-service JWT configurations)
JWT_SECRET_KEY=supersecretjwtkeyforauthservicelocaldvelopment12345
JWT_ALGORITHM=HS256
