ENVIRONMENT=development
DEBUG=true

# Cassandra Connection
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=graphgpt_conversations
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_TIMEOUT_SECONDS=5.0

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_NODES=localhost:6379
REDIS_TIMEOUT_SECONDS=2.0

# Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# LLM gRPC Stream Connection
LLM_SERVICE_GRPC_ENDPOINT=localhost:50051

# JWT Auth
JWT_SECRET_KEY=supersecretjwtkeyforauthservicelocaldvelopment12345
JWT_ALGORITHM=HS256

# Outbox Settings
OUTBOX_POLL_INTERVAL_SECONDS=0.25
OUTBOX_RETRY_INTERVAL_SECONDS=30.0
OUTBOX_STALE_THRESHOLD_SECONDS=30.0
OUTBOX_BUCKETS=32

# gRPC Client Settings
GRPC_RETRY_ATTEMPTS=3
GRPC_RETRY_BACKOFF_BASE=1.0
GRPC_CHUNK_TIMEOUT_SECONDS=60.0
GRPC_STREAM_TIMEOUT_SECONDS=3600.0

# Idempotency Settings
IDEMPOTENCY_TTL_SECONDS=86400

# Redis Connection Pools
REDIS_MAX_CONNECTIONS=100

# Kafka Performance Settings
KAFKA_LINGER_MS=5
KAFKA_MAX_BATCH_SIZE=16384
KAFKA_MAX_REQUEST_SIZE=1048576

# gRPC Connection Keepalive Settings
GRPC_KEEPALIVE_TIME_MS=20000
GRPC_KEEPALIVE_TIMEOUT_MS=10000

# SSE Stream & PubSub Settings
STREAM_OWNERSHIP_TTL_SECONDS=60
STREAM_HEARTBEAT_INTERVAL_SECONDS=20.0
STREAM_PUBSUB_TIMEOUT_SECONDS=1.0
STREAM_ERROR_SLEEP_SECONDS=0.5

# Cache TTL Configuration Settings
CACHE_TTL_SECONDS=3600

# Worker Sleep Settings
SUMMARY_WORKER_ERROR_SLEEP_SECONDS=1.0

# Pagination Limit & Bounds Settings
CONVERSATION_LIST_DEFAULT_LIMIT=20
CONVERSATION_LIST_MIN_LIMIT=1
CONVERSATION_LIST_MAX_LIMIT=100
MESSAGE_HISTORY_DEFAULT_LIMIT=50
MESSAGE_HISTORY_MIN_LIMIT=1
MESSAGE_HISTORY_MAX_LIMIT=100
CACHE_HISTORY_LIMIT=50

