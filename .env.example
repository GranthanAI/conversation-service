ENVIRONMENT=development
DEBUG=true

# Cassandra Connection
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=graphgpt_conversations
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_TIMEOUT_SECONDS=5.0

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_NODES=localhost:6379
REDIS_TIMEOUT_SECONDS=2.0

# Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# LLM gRPC Stream Connection
LLM_SERVICE_GRPC_ENDPOINT=localhost:50051

# JWT Auth
JWT_SECRET_KEY=supersecretjwtkeyforauthservicelocaldvelopment12345
JWT_ALGORITHM=HS256
