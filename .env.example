ENVIRONMENT=development
DEBUG=true

# Cassandra Connection
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=graphgpt_conversations
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_TIMEOUT_SECONDS=5.0

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_NODES=localhost:6379
REDIS_TIMEOUT_SECONDS=2.0

# Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Auth
JWT_SECRET_KEY=supersecretjwtkeyforauthservicelocaldvelopment12345
JWT_ALGORITHM=HS256

# Outbox Settings
OUTBOX_POLL_INTERVAL_SECONDS=0.25
OUTBOX_RETRY_INTERVAL_SECONDS=30.0
OUTBOX_STALE_THRESHOLD_SECONDS=30.0
OUTBOX_BUCKETS=32

# Idempotency Settings
IDEMPOTENCY_TTL_SECONDS=86400

# Redis Connection Pools
REDIS_MAX_CONNECTIONS=100

# Kafka Performance Settings
KAFKA_LINGER_MS=5
KAFKA_MAX_BATCH_SIZE=16384
KAFKA_MAX_REQUEST_SIZE=1048576

# SSE Stream & PubSub Settings
STREAM_OWNERSHIP_TTL_SECONDS=60
STREAM_HEARTBEAT_INTERVAL_SECONDS=20.0
STREAM_PUBSUB_TIMEOUT_SECONDS=1.0
STREAM_ERROR_SLEEP_SECONDS=0.5

# Cache TTL Configuration Settings
CACHE_TTL_SECONDS=3600

# Worker Sleep Settings
SUMMARY_WORKER_ERROR_SLEEP_SECONDS=1.0

# Pagination Limit & Bounds Settings
CONVERSATION_LIST_DEFAULT_LIMIT=20
CONVERSATION_LIST_MIN_LIMIT=1
CONVERSATION_LIST_MAX_LIMIT=100
MESSAGE_HISTORY_DEFAULT_LIMIT=50
MESSAGE_HISTORY_MIN_LIMIT=1
MESSAGE_HISTORY_MAX_LIMIT=100
CACHE_HISTORY_LIMIT=50

# Distributed Outbox lock settings
OUTBOX_LOCK_TTL_SECONDS=10.0
OUTBOX_LOCK_RENEW_INTERVAL_SECONDS=3.0
OUTBOX_WORKER_CONCURRENCY=8

# Pending Response Timeout Settings (llm-service Kafka round-trip watchdog)
PENDING_RESPONSE_TIMEOUT_SECONDS=120
PENDING_TIMEOUT_WORKER_POLL_INTERVAL_SECONDS=5.0

DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5433/conversation_service_db

# --- Artifact registry + exports (PostgreSQL state, private S3-compatible bucket) ---
# Reuses the existing file-minio server with its OWN bucket; create dedicated credentials in production.
ARTIFACT_STORE_ENDPOINT=localhost:9010
ARTIFACT_STORE_ACCESS_KEY=minioadmin
ARTIFACT_STORE_SECRET_KEY=minioadmin123
ARTIFACT_STORE_BUCKET=granthan-artifacts
ARTIFACT_STORE_SECURE=false
ARTIFACT_WORKER_ENABLED=true
EXPORT_WORKER_ENABLED=true
EXPORT_RETENTION_HOURS=24
EXPORT_MAX_CONVERSATIONS=500
EXPORT_MAX_ARCHIVE_BYTES=524288000

# Windows dev only: Pango/GLib DLL folder for PDF export (MSYS2: pacman -S mingw-w64-x86_64-pango)
# WEASYPRINT_DLL_DIRECTORIES=C:/msys64/mingw64/bin
